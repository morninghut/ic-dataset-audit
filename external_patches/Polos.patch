@@ -0,0 +1,116 @@
+"""Adapters for the Composite, PASCAL-50S and FOIL evaluation assets."""
+from collections import Counter, defaultdict
+import json
+from pathlib import Path
+import random
+
+
+def load_composite(root):
+    source = root / 'composite/composite.jsonl'
+    with source.open() as handle:
+        rows = [json.loads(line) for line in handle if line.strip()]
+    for row in rows:
+        row['image'] = str(source.parent / row['image'])
+    return rows, source, 0
+
+
+def matlab_scalar(value):
+    while hasattr(value, 'shape') and len(value.shape) > 0 and value.size == 1:
+        value = value.reshape(-1)[0]
+    return value
+
+
+def load_pascal(root, seed=42):
+    from scipy.io import loadmat
+    base = root / 'pascal'
+    source = base / 'pyCIDErConsensus/pair_pascal.mat'
+    pairs = loadmat(source)
+    triplets = loadmat(base / 'pyCIDErConsensus/consensus_pascal.mat')['triplets'][0]
+    items, categories = pairs['new_input'][0], pairs['category'][0]
+    if len(items) != 4000 or len(triplets) != 48 * len(items):
+        raise ValueError('Expected 4,000 Pascal pairs with 48 judgments each.')
+    rng = random.Random(seed)
+    names = {1: 'HC', 2: 'HI', 3: 'HM', 4: 'MM'}
+    records = []
+    for index, item in enumerate(items):
+        image, a, b = (str(matlab_scalar(item[i])).strip() for i in range(3))
+        votes, refs = Counter(), []
+        for triplet in triplets[index * 48:(index + 1) * 48]:
+            ref, option_a, option_b = (str(matlab_scalar(triplet[i])).strip() for i in range(3))
+            choice = int(matlab_scalar(triplet[3]))
+            if choice not in (1, -1):
+                raise ValueError(f'Invalid Pascal vote: {choice}')
+            votes[option_a if choice == 1 else option_b] += 1
+            refs.append(ref)
+        # Match the released seed=42 tie handling, consuming one draw per pair.
+        label = 0 if votes[a] > votes[b] + rng.random() - .5 else 1
+        records.append(dict(id=str(index), image=str(base / 'VOCdevkit/VOC2010/JPEGImages' / image),
+                            caption_a=a, caption_b=b, references=refs, preferred=label,
+                            category=names[int(matlab_scalar(categories[index]))]))
+    if Counter(r['category'] for r in records) != dict.fromkeys(names.values(), 1000):
+        raise ValueError('Expected 1,000 Pascal pairs in each category.')
+    return records, source, 0
+
+
+def load_foil(root, one_ref):
+    source = root / 'foil/foilv1.0_test_2017.json'
+    with (root / 'coco/captions_val2014.json').open() as handle:
+        coco = json.load(handle)
+    refs = defaultdict(list)
+    for annotation in coco['annotations']:
+        refs[annotation['image_id']].append(annotation['caption'])
+    with source.open() as handle:
+        foil = json.load(handle)
+    images = {image['id']: image['file_name'] for image in foil['images']}
+    groups = {}
+    for annotation in foil['annotations']:
+        group = groups.setdefault(annotation['id'], {'orig': [], 'foil': []})
+        group['foil' if annotation['foil'] else 'orig'].append(annotation)
+    records = []
+    for key, group in groups.items():
+        if len(group['orig']) != 1:
+            raise ValueError(f'FOIL annotation {key} needs exactly one original.')
+        original = group['orig'][0]
+        references = [r for r in refs[original['image_id']] if r != original['caption']]
+        if not references:
+            raise ValueError(f'FOIL annotation {key} has no held-out references.')
+        if one_ref:
+            references = references[:1]
+        for index, changed in enumerate(group['foil']):
+            if changed['image_id'] != original['image_id']:
+                raise ValueError(f'FOIL image mismatch at {key}')
+            records.append(dict(id=f'{key}:{index}',
+                                image=str(root / 'coco/val2014' / images[original['image_id']]),
+                                caption_a=original['caption'], caption_b=changed['caption'],
+                                preferred=0, references=references, category='foil'))
+    return records, source, 0
+
+
+def pascal_trials(records, protocol, seed):
+    if protocol == 'released':
+        return [{**row, 'trial': 0} for row in records]
+    rng = random.Random(seed)
+    return [{**row, 'trial': trial, 'references': rng.sample(row['references'], 5)}
+            for trial in range(5) for row in records]
+
+
+def pairwise_metrics(records, scores, strict=False):
+    """Scores alternate A/B; FOIL requires A>B, Pascal ties select B."""
+    if len(scores) != 2 * len(records) or not records:
+        raise ValueError('Pairwise scores must contain both candidates for every pair.')
+    groups = defaultdict(lambda: [0, 0, 0])
+    for index, row in enumerate(records):
+        a, b = scores[2 * index:2 * index + 2]
+        correct = a > b if strict else (0 if a > b else 1) == row['preferred']
+        group = groups[(row.get('trial', 0), row['category'])]
+        group[0] += int(correct)
+        group[1] += 1
+        group[2] += int(a == b)
+    trials = {}
+    for (trial, category), (correct, count, ties) in groups.items():
+        trials.setdefault(str(trial), {})[category] = dict(accuracy=correct / count,
+                                                         correct=correct, count=count, ties=ties)
+    categories = sorted({row['category'] for row in records})
+    means = {cat: sum(t[cat]['accuracy'] for t in trials.values()) / len(trials) for cat in categories}
+    return {'accuracy': sum(means.values()) / len(means), 'by_category': means, 'trials': trials,
+            'ties': sum(g[2] for g in groups.values())}
