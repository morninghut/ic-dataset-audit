@@ -0,0 +1,33 @@
+"""SigLIP's native image and text representations behind the CLIP interface."""
+import torch
+from transformers import SiglipModel, SiglipProcessor
+
+
+class SiglipAdapter(torch.nn.Module):
+    def __init__(self, path, image_batch_size=4):
+        super().__init__()
+        self.model = SiglipModel.from_pretrained(path, local_files_only=True)
